local function solveMath(text)
    if type(text) ~= "string" then return nil end

    local expr = text:match("[Ww]hat is%s+(.-)%?")
    if not expr then
        expr = text:match("(%d+[%d%s%+%-%*/%^xX×÷²³⁴%.%(%)]+)")
    end
    if not expr then return nil end

    local function evaluate(raw)
        if not raw or raw == "" then return nil end
        local s = raw
        s = s:gsub("×", "*"):gsub("[xX]", "*")
        s = s:gsub("÷", "/")
        s = s:gsub("²", "^2"):gsub("³", "^3"):gsub("⁴", "^4")
        s = s:gsub("–", "-"):gsub("—", "-")
        s = s:gsub("[^%d%+%-%*/%^%s%.%(%)]", "")
        if not s:match("%d") then return nil end

        local f = loadstring("return " .. s)
        if f then
            local success, result = pcall(f)
            if success and type(result) == "number" and result == result and result ~= (1/0) and result ~= (-1/0) then
                if result == math.floor(result) then
                    return tostring(math.floor(result))
                else
                    return tostring(result)
                end
            end
        end
        return nil
    end

    -- 1. Try parenthesized explanation first (e.g. "30² (30 × 30)" -> "30 × 30")
    local parenthesized = expr:match("%((.-)%)")
    if parenthesized then
        local ans = evaluate(parenthesized)
        if ans then return ans end
    end

    -- 2. Try stripped expression (e.g. "30²" from "30² (30 × 30)")
    local stripped = expr:gsub("%b()", "")
    local ans = evaluate(stripped)
    if ans then return ans end

    -- 3. Fallback to raw expression
    return evaluate(expr)
end

