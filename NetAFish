local autoThrowNet = Config.AutoThrowNet
local throwing = false

local function getOptimalThrow()
    local myBase = getMyBase()
    local targetZ = 100.74
    local targetOut = 13.9

    if myBase then
        local baseZ = myBase.PrimaryPart and myBase.PrimaryPart.Position.Z or myBase:GetPivot().Position.Z
        if baseZ then
            targetZ = baseZ
        end

        local n4 = 20
        pcall(function()
            local data = getPlayerData()
            n4 = FishingShared.CastStats(data, FishingShared.EquippedBait(data)).reach
        end)
        local maxOut = FishingShared.NetMaxOut(n4)
        if maxOut and maxOut > 0 then
            targetOut = maxOut
        end
    end

    return targetZ, targetOut
end

local reelCapacityPercent = Config.ReelCapacityPercent
local checkingBait = false

local function getBestBait(state)
    local rebirths = state.rebirths or 0
    local cash = state.cash or 0
    local prices = state.prices or {}
    local baits = state.baits or {}

    if FishingShared.Baits then
        for i = #FishingShared.Baits, 1, -1 do
            local b = FishingShared.Baits[i]
            local reqRebirth = b.Rebirth or 0
            local price = prices[b.Id] or b.Cost or (1 / 0)
            local owned = baits[b.Id] or 0

            if rebirths >= reqRebirth then
                if owned > 0 or cash >= price then
                    return b.Id
                end
            end
        end
    end

    return "Crumbs"
end

local function checkAndManageBait()
    if checkingBait or not TackleRemote then return end
    checkingBait = true

    pcall(function()
        local state = TackleRemote:InvokeServer("state")
        if not state then return end

        local bestBait = getBestBait(state)
        local owned = state.baits and state.baits[bestBait] or 0
        local equipped = state.bait

        -- only buy 1 when no bait
        if owned <= 0 then
            local price = state.prices and state.prices[bestBait] or 0
            if (state.cash or 0) >= price and price > 0 then
                TackleRemote:InvokeServer("buyBait", bestBait, 1)
                owned = 1
                task.wait(0.2)
            end
        end

        -- equip if owned and not currently equipped
        if equipped ~= bestBait and owned > 0 then
            TackleRemote:InvokeServer("equipBait", bestBait, nil)
        end
    end)

    checkingBait = false
end

local function checkNetAndReel()
    if not autoThrowNet or throwing then return end
    local myBase = getMyBase()
    if not myBase then return end

    local netState = myBase:GetAttribute("NetState")
    if netState == "Idle" and ThrowNetEvent then
        throwing = true
        checkAndManageBait()
        local z, out = getOptimalThrow()
        pcall(function()
            ThrowNetEvent:FireServer(z, out)
        end)
        task.wait(1)
        throwing = false
    elseif (netState == "Fishing" or netState == "Out") and ReelInEvent then
        local netCount = myBase:GetAttribute("NetCount") or 0
        local netCap = myBase:GetAttribute("NetCap") or 1
        local targetCount = math.max(1, math.floor(netCap * (reelCapacityPercent / 100)))

        if netCount >= targetCount and netCount > 0 then
            pcall(function()
                ReelInEvent:FireServer()
            end)
            task.wait(1)
        end
    end
end

