local function dismissInGameAFK()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local afkScreen = playerGui and playerGui:FindFirstChild("AFKModeScreen")
    if afkScreen and afkScreen.Enabled then
        local afkBack = afkScreen:FindFirstChild("AFKBack", true)
        if afkBack and typeof(firesignal) == "function" then
            firesignal(afkBack.MouseButton1Click)
        else
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.RightControl, false, game)
            task.wait(0.02)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.RightControl, false, game)
        end
    end
    if LocalPlayer:GetAttribute("AFKScreen") then
        LocalPlayer:SetAttribute("AFKScreen", nil)
        pcall(function()
            RunService:Set3dRenderingEnabled(true)
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local afkState = remotes and remotes:FindFirstChild("AFKState")
            if afkState then
                afkState:FireServer(false)
            end
        end)
    end
end

