local autoClaimContracts = Config.AutoClaimContracts
local checkingContracts = false
local contractTimers = {}

local function checkAndClaimContracts()
    if not autoClaimContracts or checkingContracts or not ContractsRemote then return end
    checkingContracts = true

    pcall(function()
        local data = getPlayerData()
        local contracts = data and data.Contracts

        if type(contracts) == "table" then
            for slotIndex = 1, 3 do
                local c = contracts[slotIndex]
                if not autoClaimContracts then break end
                if type(c) == "table" and c.k ~= "wait" and (c.p or 0) >= (c.goal or 1e999) then
                    local ok, res = pcall(function()
                        return ContractsRemote:InvokeServer("claim", slotIndex)
                    end)
                    if ok and res and res.ok then
                        contractTimers[slotIndex] = nil
                        if data and data.Contracts and data.Contracts[slotIndex] then
                            data.Contracts[slotIndex].k = "wait"
                        end
                    end
                    task.wait(0.3)
                end
            end

            for slotIndex = 1, 3 do
                local c = contracts[slotIndex]
                if type(c) == "table" and c.k ~= "wait" and not c.done and ((c.p or 0) < (c.goal or 1e999)) then
                    if not contractTimers[slotIndex] then
                        contractTimers[slotIndex] = os.clock()
                    elseif os.clock() - contractTimers[slotIndex] >= 600 then
                        pcall(function()
                            ContractsRemote:InvokeServer("reroll", slotIndex)
                        end)
                        contractTimers[slotIndex] = os.clock()
                    end
                else
                    contractTimers[slotIndex] = nil
                end
            end
        else
            local res = ContractsRemote:InvokeServer("state")
            if res and type(res.list) == "table" then
                for slotIndex = 1, 3 do
                    local c = res.list[slotIndex]
                    if not autoClaimContracts then break end
                    if type(c) == "table" and c.k ~= "wait" and c.done == true then
                        ContractsRemote:InvokeServer("claim", slotIndex)
                        contractTimers[slotIndex] = nil
                        task.wait(0.3)
                    end
                end

                for slotIndex = 1, 3 do
                    local c = res.list[slotIndex]
                    if type(c) == "table" and c.k ~= "wait" and not c.done then
                        if not contractTimers[slotIndex] then
                            contractTimers[slotIndex] = os.clock()
                        elseif os.clock() - contractTimers[slotIndex] >= 600 then
                            pcall(function()
                                ContractsRemote:InvokeServer("reroll", slotIndex)
                            end)
                            contractTimers[slotIndex] = os.clock()
                        end
                    else
                        contractTimers[slotIndex] = nil
                    end
                end
            end
        end
    end)

    checkingContracts = false
end

