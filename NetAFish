local autoMiniGame = Config.AutoMiniGame
local miniGameConnection = nil
local lastReelPress = 0
local lastInviteAction = 0
local lastCollectClick = 0
local lastJumpSwing = 0
local luresRunning = false
local lastLuresChain = 0

local function stepMiniGame()
    if not autoMiniGame then return end

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local miniGameGui = playerGui and playerGui:FindFirstChild("MiniGameUI")
    if not miniGameGui or not miniGameGui.Enabled then
        lastLuresChain = 0
        luresRunning = false
        return
    end

    -- 1. Auto-collect results / rewards
    local collectBtn = miniGameGui:FindFirstChild("Collect", true)
    if collectBtn and collectBtn:IsA("GuiButton") and collectBtn.Visible then
        if os.clock() - lastCollectClick >= 1.0 then
            lastCollectClick = os.clock()
            pcall(function()
                if typeof(firesignal) == "function" then
                    firesignal(collectBtn.MouseButton1Click)
                end
            end)
        end
        return
    end

    -- 2. Auto-enter invite on Extreme
    local playBtn = miniGameGui:FindFirstChild("PlayButton", true)
    if playBtn and playBtn:IsA("GuiButton") and playBtn.Visible then
        local window = playBtn.Parent and playBtn.Parent.Parent
        if window and window:IsA("GuiObject") and window.Visible then
            if os.clock() - lastInviteAction >= 1.0 then
                lastInviteAction = os.clock()
                task.spawn(function()
                    local diffExtreme = miniGameGui:FindFirstChild("DiffExtreme", true)
                    if diffExtreme and diffExtreme:IsA("GuiButton") and diffExtreme.Visible then
                        pcall(function()
                            if typeof(firesignal) == "function" then
                                firesignal(diffExtreme.MouseButton1Click)
                            end
                        end)
                        task.wait(0.15)
                    end
                    pcall(function()
                        if typeof(firesignal) == "function" then
                            firesignal(playBtn.MouseButton1Click)
                        end
                    end)
                end)
            end
            return
        end
    end

    -- 3. Auto-reel: Stop needle in the green / gold for PERFECT!
    local needle, zone, reelBtn
    for _, desc in ipairs(miniGameGui:GetDescendants()) do
        if desc:IsA("Frame") then
            if desc.ZIndex == 8 and desc.Size.X.Offset == 8 then
                needle = desc
            elseif desc.ZIndex == 5 and desc:FindFirstChildWhichIsA("Frame") then
                zone = desc
            end
        elseif desc:IsA("GuiButton") and (desc.Name == "ReelButton" or (desc.Parent and desc.Parent.Name == "ReelButton")) then
            reelBtn = desc
        end
    end

    if needle and zone and reelBtn and reelBtn.Visible then
        local zoneCenter = zone.Position.X.Scale
        local zoneWidth = zone.Size.X.Scale
        local needlePos = needle.Position.X.Scale
        local dist = math.abs(needlePos - zoneCenter)

        if dist <= (zoneWidth * 0.14) and (os.clock() - lastReelPress >= 0.35) then
            lastReelPress = os.clock()
            pcall(function()
                if typeof(firesignal) == "function" then
                    firesignal(reelBtn.MouseButton1Down)
                end
            end)
        end
        return
    end

    -- 4. Auto-catch in Jump Minigame (spots 1 to 5)
    for i = 1, 5 do
        local spot = miniGameGui:FindFirstChild("Spot" .. i, true)
        if spot and spot:IsA("GuiButton") and spot.Visible then
            local hasFish = false
            local isBoot = false
            for _, child in ipairs(spot:GetChildren()) do
                if child:IsA("TextLabel") or child:IsA("ImageLabel") or child.Name == "Fish" or child.Name:find("Label") then
                    hasFish = true
                    if child:IsA("TextLabel") and child.Text:find("BOOT") then
                        isBoot = true
                    end
                end
            end
            if hasFish and not isBoot and (os.clock() - lastJumpSwing >= 0.3) then
                lastJumpSwing = os.clock()
                pcall(function()
                    if typeof(firesignal) == "function" then
                        firesignal(spot.MouseButton1Down)
                    end
                end)
                break
            end
        end
    end

    -- 5. Auto-solve Bait Memory (Lures)
    if not luresRunning then
        local titleLabel = miniGameGui:FindFirstChild("Title", true) or miniGameGui:FindFirstChild("Header", true)
        local isLures = false
        if titleLabel and titleLabel:IsA("TextLabel") then
            local t = titleLabel.Text:upper()
            if t:find("BAIT") or t:find("MEMORY") or t:find("LURE") then
                isLures = true
            end
        end
        if not isLures then
            for _, desc in ipairs(miniGameGui:GetDescendants()) do
                if desc:IsA("TextLabel") and desc.Visible and (desc.Text:find("BAIT MEMORY") or desc.Text:find("Bait Memory")) then
                    isLures = true
                    break
                end
            end
        end

        if isLures then
            local area = miniGameGui:FindFirstChild("Area", true) or miniGameGui
            local buttons = {}
            for _, desc in ipairs(area:GetDescendants()) do
                if desc:IsA("GuiButton") and desc.Visible then
                    local n = desc.Name
                    if not n:find("Diff") and not n:find("Play") and not n:find("Collect") and not n:find("Close") and not n:find("Reel") and not n:find("Spot") then
                        table.insert(buttons, desc)
                    end
                end
            end

            if #buttons >= 3 then
                table.sort(buttons, function(a, b)
                    return a.AbsolutePosition.X < b.AbsolutePosition.X
                end)

                local sequence = nil
                if typeof(getconnections) == "function" and typeof(getupvalues) == "function" then
                    for _, btn in ipairs(buttons) do
                        local conns = getconnections(btn.MouseButton1Down)
                        if #conns == 0 then
                            conns = getconnections(btn.MouseButton1Click)
                        end
                        for _, conn in ipairs(conns) do
                            local fn = conn.Function
                            if fn and (typeof(islclosure) ~= "function" or islclosure(fn)) then
                                local ups = getupvalues(fn)
                                for _, cand in pairs(ups) do
                                    if type(cand) == "table" and #cand >= 3 then
                                        local valid = true
                                        for i = 1, #cand do
                                            local elem = cand[i]
                                            if type(elem) ~= "number" or elem < 1 or elem > #buttons then
                                                valid = false
                                                break
                                            end
                                        end
                                        if valid then
                                            sequence = cand
                                            break
                                        end
                                    end
                                end
                            end
                            if sequence then break end
                        end
                        if sequence then break end
                    end
                end

                if not sequence and typeof(getgc) == "function" and typeof(getupvalues) == "function" then
                    for _, v in ipairs(getgc()) do
                        if type(v) == "function" and (typeof(islclosure) ~= "function" or islclosure(v)) then
                            local ups = getupvalues(v)
                            local isLuresClosure = false
                            for _, up in pairs(ups) do
                                if type(up) == "table" and rawget(up, "game") == "Lures" then
                                    isLuresClosure = true
                                    break
                                end
                            end
                            if isLuresClosure then
                                for _, cand in pairs(ups) do
                                    if type(cand) == "table" and #cand >= 3 then
                                        local valid = true
                                        for i = 1, #cand do
                                            local elem = cand[i]
                                            if type(elem) ~= "number" or elem < 1 or elem > #buttons then
                                                valid = false
                                                break
                                            end
                                        end
                                        if valid then
                                            sequence = cand
                                            break
                                        end
                                    end
                                end
                            end
                        end
                        if sequence then break end
                    end
                end

                if sequence and #sequence > lastLuresChain then
                    luresRunning = true
                    task.spawn(function()
                        local chainLen = #sequence
                        local showDuration = 0.65 + (chainLen * 0.40)
                        task.wait(showDuration)

                        if not miniGameGui or not miniGameGui.Enabled or not autoMiniGame then
                            luresRunning = false
                            return
                        end

                        for step = 1, chainLen do
                            if not miniGameGui or not miniGameGui.Enabled or not autoMiniGame then break end
                            local lureIdx = sequence[step]
                            local targetBtn = buttons[lureIdx]
                            if targetBtn and targetBtn.Visible then
                                pcall(function()
                                    if typeof(firesignal) == "function" then
                                        firesignal(targetBtn.MouseButton1Down)
                                        firesignal(targetBtn.MouseButton1Click)
                                    end
                                end)
                            end
                            task.wait(0.22)
                        end

                        lastLuresChain = chainLen
                        task.wait(0.8)
                        luresRunning = false
                    end)
                end
            end
        end
    end
end

local function startMiniGameAutomation()
    if miniGameConnection then
        miniGameConnection:Disconnect()
        miniGameConnection = nil
    end
    if autoMiniGame then
        miniGameConnection = RunService.Heartbeat:Connect(stepMiniGame)
    end
end

