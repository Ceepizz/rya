local autoCollectPads = Config.AutoCollectPads
local collectingPads = false

local function collectAllPads()
    if collectingPads then return end
    collectingPads = true

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local myBase = getMyBase()

    if not hrp or not myBase or not CollectPadReqEvent then
        collectingPads = false
        return
    end

    local pedestals = myBase:FindFirstChild("Pedestals")
    if not pedestals then
        collectingPads = false
        return
    end

    local originalCF = hrp.CFrame

    for _, p in ipairs(pedestals:GetChildren()) do
        if not autoCollectPads then break end
        local slot = p:GetAttribute("Slot")
        local open = p:GetAttribute("Open")
        local collectModel = p:FindFirstChild("Collect")
        local pad = collectModel and collectModel:FindFirstChild("Pad")

        if open and pad and slot then
            pcall(function()
                hrp.CFrame = pad.CFrame + Vector3.new(0, 2.5, 0)
                hrp.AssemblyLinearVelocity = Vector3.zero
            end)
            task.wait(0.6)
            pcall(function()
                CollectPadReqEvent:FireServer(slot)
            end)
            task.wait(0.2)
        end
    end

    -- Return to starting position
    pcall(function()
        hrp.CFrame = originalCF
        hrp.AssemblyLinearVelocity = Vector3.zero
    end)

    collectingPads = false
end

