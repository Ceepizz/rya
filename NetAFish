local autoBuyNet = Config.AutoBuyNet
local checkingNet = false

local function checkAndBuyNet()
    if not autoBuyNet or checkingNet then return end
    checkingNet = true

    local data = getPlayerData()
    if data and BuyItemEvent then
        local currentTier = data.NetTier or 1
        local nextTier = currentTier + 1
        local netDef = FishingShared.Nets[nextTier]

        while netDef and autoBuyNet do
            local rebirthOk = FishingShared.NetRebirthOk(data, nextTier)
            local canAfford = (data.Cash or 0) >= netDef.Cost

            if rebirthOk and canAfford then
                pcall(function()
                    BuyItemEvent:FireServer("Net", nextTier)
                end)
                task.wait(0.5)

                data.Cash = data.Cash - netDef.Cost
                data.NetTier = nextTier
                currentTier = nextTier
                nextTier = currentTier + 1
                netDef = FishingShared.Nets[nextTier]
            else
                break
            end
        end
    end

    checkingNet = false
end

