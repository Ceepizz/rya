local function hasBetterFish()
    local myBase = getMyBase()
    if not myBase then return false end

    local pedestals = myBase:FindFirstChild("Pedestals")
    local showcase = myBase:FindFirstChild("ShowcaseFish")
    if not pedestals or not showcase then return false end

    local openPedestals = 0
    for _, p in ipairs(pedestals:GetChildren()) do
        if p:GetAttribute("Open") == true then
            openPedestals += 1
        end
    end

    local equippedFish = showcase:GetChildren()
    local lowestEquippedIncome = math.huge

    for _, slot in ipairs(equippedFish) do
        local fishId = slot:GetAttribute("FishId")
        local species = FishingShared.SpeciesById[fishId]
        local size = slot:GetAttribute("BoneScale") or 1
        local mutation = slot:GetAttribute("Mutation")
        local mult = FishingShared.MutationMult and FishingShared.MutationMult(mutation) or 1
        local val = species and math.floor(FishingShared.FishValue(species, size) * mult + 0.5) or 0
        if val < lowestEquippedIncome then
            lowestEquippedIncome = val
        end
    end

    if #equippedFish == 0 then
        lowestEquippedIncome = 0
    end

    local dataCacheModule = LocalPlayer:FindFirstChild("PlayerScripts") and LocalPlayer.PlayerScripts:FindFirstChild("DataCache")
    local dataCache = dataCacheModule and require(dataCacheModule)
    local cooler = dataCache and dataCache.cooler

    if type(cooler) ~= "table" then
        return false
    end

    local bestCoolerVal = 0
    for _, stack in pairs(cooler) do
        if type(stack) == "table" and (stack.n or 0) > 0 then
            local fish = FishingShared.CoolerBest(stack)
            if fish and (fish.v or 0) > bestCoolerVal then
                bestCoolerVal = fish.v
            end
        end
    end

    if #equippedFish < openPedestals and bestCoolerVal > 0 then
        return true
    end

    return bestCoolerVal > lowestEquippedIncome
end

