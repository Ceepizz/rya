local autoBuyUpgrades = Config.AutoBuyUpgrades
local checkingUpgrades = false

local function checkAndBuyUpgrades()
    if not autoBuyUpgrades or checkingUpgrades then return end
    checkingUpgrades = true

    local data = getPlayerData()
    if data and BuyItemEvent and FishingShared.Upgrades then
        local candidates = {}
        for _, u in ipairs(FishingShared.Upgrades) do
            -- Includes both Fishing and Market tabs
            if (u.Tab == "Fishing" or u.Tab == "Market") and not u.Hidden then
                local curLevel = data.Upgrades and data.Upgrades[u.Id] or 0
                if curLevel < u.Max then
                    local okLevel = false
                    pcall(function()
                        okLevel = FishingShared.UpgradeLevelOk(data, u, curLevel + 1)
                    end)
                    local cost = FishingShared.UpgradeCost(u.Id, curLevel)
                    if okLevel and (data.Cash or 0) >= cost then
                        table.insert(candidates, {
                            id = u.Id,
