local CONFIG_FILE = "NetAFish_Config.json"

local Config = {
    AutoThrowNet = false,
    ReelCapacityPercent = 100,
    AutoCollectPads = false,
    AutoEquip = false,
    AutoRebirth = false,
    AutoBuyNet = false,
    AutoBuyUpgrades = false,
