local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local currentCharacter = player.Character

local function isMyCharacter(obj)
	if not currentCharacter then
		return false
	end

	return obj == currentCharacter
		or obj:IsDescendantOf(currentCharacter)
end

local function hideTowerObject(obj)
	if obj:IsA("BasePart") then
		obj.LocalTransparencyModifier = 1
		obj.Transparency = 1
		obj.CastShadow = false
		obj.Reflectance = 0

	elseif obj:IsA("Decal")
		or obj:IsA("Texture")
		or obj:IsA("SurfaceAppearance") then

		pcall(function()
			obj:Destroy()
		end)

	elseif obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles") then

		obj.Enabled = false

	elseif obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight") then

		obj.Enabled = false

	elseif obj:IsA("BillboardGui")
		or obj:IsA("SurfaceGui") then

		obj.Enabled = false

	elseif obj:IsA("Highlight") then
		obj.Enabled = false
	end
end

local function hideTower(tower)
	for _, obj in ipairs(tower:GetDescendants()) do
		pcall(function()
			hideTowerObject(obj)
		end)
	end

	tower.DescendantAdded:Connect(function(obj)
		task.defer(function()
			pcall(function()
				hideTowerObject(obj)
			end)
		end)
	end)
end

local function setupTowerHider()
	local towers = Workspace:FindFirstChild("Towers")

	if not towers then
		towers = Workspace:WaitForChild("Towers", 30)
	end

	if not towers then
		return
	end

	for _, tower in ipairs(towers:GetChildren()) do
		hideTower(tower)
	end

	towers.ChildAdded:Connect(function(tower)
		task.defer(function()
			hideTower(tower)
		end)
	end)
end

local function nukeVisual(obj)
	if isMyCharacter(obj) then
		return
	end

	if obj:IsA("Folder")
		or obj:IsA("Model") then
		return
	end

	if obj:IsA("BasePart") then
		obj.Transparency = 1
		obj.LocalTransparencyModifier = 1
		obj.CastShadow = false
		obj.Reflectance = 0
		return
	end

	if obj:IsA("Decal")
		or obj:IsA("Texture")
		or obj:IsA("SurfaceAppearance")
		or obj:IsA("SpecialMesh")
		or obj:IsA("Mesh") then

		obj:Destroy()
		return
	end

	if obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles") then

		obj.Enabled = false

		pcall(function()
			obj:Destroy()
		end)

		return
	end

	if obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight") then

		obj.Enabled = false

		pcall(function()
			obj:Destroy()
		end)

		return
	end

	if obj:IsA("BillboardGui")
		or obj:IsA("SurfaceGui") then

		obj.Enabled = false

		pcall(function()
			obj:Destroy()
		end)

		return
	end

	if obj:IsA("Highlight") then
		obj.Enabled = false

		pcall(function()
			obj:Destroy()
		end)

		return
	end
end

pcall(function()
	settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
end)

Lighting.GlobalShadows = false
Lighting.Brightness = 0
Lighting.FogEnd = 1000000
Lighting.EnvironmentDiffuseScale = 0
Lighting.EnvironmentSpecularScale = 0

for _, obj in ipairs(Lighting:GetChildren()) do
	if obj:IsA("PostEffect")
		or obj:IsA("Atmosphere")
		or obj:IsA("Sky") then

		pcall(function()
			obj:Destroy()
		end)
	end
end

pcall(function()
	Workspace.Terrain:Clear()
end)

pcall(function()
	Workspace.Terrain.WaterWaveSize = 0
	Workspace.Terrain.WaterWaveSpeed = 0
	Workspace.Terrain.WaterReflectance = 0
	Workspace.Terrain.WaterTransparency = 1
end)

task.spawn(setupTowerHider)

for _, obj in ipairs(Workspace:GetDescendants()) do
	pcall(function()
		nukeVisual(obj)
	end)
end

Workspace.DescendantAdded:Connect(function(obj)
	task.defer(function()
		if isMyCharacter(obj) then
			return
		end

		pcall(function()
			nukeVisual(obj)
		end)
	end)
end)

local function makePlatform(character)
	currentCharacter = character

	local root =
		character:WaitForChild("HumanoidRootPart")

	local old =
		Workspace:FindFirstChild("ANTI_LAG_PLATFORM")

	if old then
		old:Destroy()
	end

	local platform = Instance.new("Part")

	platform.Name = "ANTI_LAG_PLATFORM"

	platform.Size =
		Vector3.new(
			2000,
			5,
			2000
		)

	platform.Position =
		root.Position
		- Vector3.new(0, 4, 0)

	platform.Anchored = true
	platform.CanCollide = true
	platform.CanTouch = false
	platform.CanQuery = false

	platform.Transparency = 1
	platform.LocalTransparencyModifier = 1
	platform.CastShadow = false

	platform.Parent = Workspace
end

if player.Character then
	makePlatform(player.Character)
end

player.CharacterAdded:Connect(function(character)
	currentCharacter = character

	task.wait(0.25)

	makePlatform(character)
end)
